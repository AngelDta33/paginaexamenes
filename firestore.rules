rules_version = '2';

// Reglas para el constructor de exámenes.
// Roles viven en usuarios/{uid}.rol (no se usan custom claims: el alta de cuentas
// es 100% cliente, sin Cloud Functions, para no requerir el plan Blaze).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return autenticado() ? perfil().rol : null;
    }

    function esRevisorOAdmin() {
      return rol() == 'revisor' || rol() == 'administrador';
    }

    // usuarios/{uid}: cualquiera autenticado puede leer (se necesita para mostrar nombres
    // y para que estas mismas reglas puedan consultar el rol de quien pide). Solo un
    // administrador puede crear o modificar cuentas.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow write: if esRevisorOAdmin() && rol() == 'administrador';
    }

    // usuariosEliminados/{uid}: constancia de las bajas de cuentas (a quién, quién
    // la dio de baja, cuándo y por qué). Se escribe justo antes de borrar
    // usuarios/{uid}, que es donde vivía esa información. Solo el administrador
    // la escribe y la consulta: es información sobre el personal, no tiene por
    // qué verla el resto de la plantilla.
    match /usuariosEliminados/{uid} {
      allow read, write: if rol() == 'administrador';
    }

    // configuracion/escuela: datos institucionales compartidos (datos de la escuela,
    // membretes y formato estándar de los exámenes — "Parámetros" del Panel
    // Administrador). Lectura para cualquier cuenta activa, porque cada examen se
    // arma con ellos; solo el administrador los edita (un revisor NO).
    match /configuracion/{docId} {
      allow read: if autenticado();
      allow write: if rol() == 'administrador';
    }

    // examenes/{id}: el dueño (profesorId) siempre puede leer/escribir lo suyo;
    // revisor y administrador pueden leer/escribir cualquier examen.
    match /examenes/{examenId} {
      allow read, update, delete: if autenticado() &&
        (resource.data.profesorId == request.auth.uid || esRevisorOAdmin());
      allow create: if autenticado() &&
        (request.resource.data.profesorId == request.auth.uid || esRevisorOAdmin());
    }

    // grupos/{id}: el documento del grupo guarda lo que NO es pase de lista — datos
    // generales, roster, rúbrica, calificaciones, valores de asistencia y calendario.
    // Escribirlo sigue siendo exclusivo del maestro dueño: revisor/administrador
    // pueden leer cualquier grupo, pero no tocar los parámetros de evaluación de
    // nadie. Lo que sí pueden corregir es el pase de lista, que vive aparte en
    // asistencias/{id} (ver más abajo) — por eso esa separación importa aquí.
    // Crear sí lo puede hacer cualquiera con su propio profesorId: revisores y
    // administradores también dan clase, así que llevan sus propios grupos.
    match /grupos/{grupoId} {
      allow read: if autenticado() && (resource.data.profesorId == request.auth.uid || esRevisorOAdmin());
      allow update, delete: if autenticado() && resource.data.profesorId == request.auth.uid;
      allow create: if autenticado() && request.resource.data.profesorId == request.auth.uid;
    }
    // programas/{id}: formato de "Programa de actividades académicas" — mismo
    // criterio de privacidad que grupos: el maestro dueño escribe lo suyo,
    // revisor/administrador pueden leer cualquiera (para el Vo.Bo. de Coordinación).
    match /programas/{programaId} {
      allow read: if autenticado() && (resource.data.profesorId == request.auth.uid || esRevisorOAdmin());
      allow update, delete: if autenticado() && resource.data.profesorId == request.auth.uid;
      allow create: if autenticado() && request.resource.data.profesorId == request.auth.uid;
    }

    // carpetas/{id}: solo organizan la lista de exámenes, privadas por maestro
    // (mismo criterio que grupos/programas) — revisor/administrador pueden ver
    // las de todos porque también ven todos los exámenes.
    match /carpetas/{carpetaId} {
      allow read: if autenticado() && (resource.data.profesorId == request.auth.uid || esRevisorOAdmin());
      allow update, delete: if autenticado() && resource.data.profesorId == request.auth.uid;
      allow create: if autenticado() && request.resource.data.profesorId == request.auth.uid;
    }

    match /asistencias/{docId} {
      // resource es null cuando el documento del día todavía no existe (primera vez que
      // se pasa lista ese día) — obtenerOCrearAsistencia hace un getDoc antes de crearlo,
      // así que la lectura tiene que permitirse aunque no haya nada que leer todavía.
      allow read: if autenticado() && (
        resource == null ||
        get(/databases/$(database)/documents/grupos/$(resource.data.grupoId)).data.profesorId == request.auth.uid ||
        esRevisorOAdmin()
      );
      // Escribir el pase de lista NO es exclusivo del maestro dueño: revisor y
      // administrador también corrigen asistencias (llega el justificante a
      // Coordinación, el maestro se equivocó de fila, faltó pasar lista un día).
      // Esto es deliberadamente más amplio que grupos/{id}, que ellos siguen sin
      // poder escribir: la asistencia vive en su propio documento justamente para
      // que se pueda abrir sin abrir con ella la rúbrica ni las calificaciones.
      // El dueño va primero (mismo orden que el allow read de arriba): así el caso
      // normal, un maestro pasando lista en su grupo, resuelve con el get de
      // grupos/ y sin consultar su propio rol, exactamente como antes.
      allow update, delete: if autenticado() && (
        get(/databases/$(database)/documents/grupos/$(resource.data.grupoId)).data.profesorId == request.auth.uid ||
        esRevisorOAdmin()
      );
      allow create: if autenticado() && (
        get(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId)).data.profesorId == request.auth.uid ||
        esRevisorOAdmin()
      );
    }
  }
}
